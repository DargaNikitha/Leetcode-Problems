class Solution(object):
    def characterReplacement(self, s, k):
        """
        :type s: str
        :type k: int
        :rtype: int
        """
        ans=0
        n=len(s)
        mf=0
        freq={}
        i=0
        for j in range(n):
            ch=s[j]
            if ch in freq:
                freq[ch]+=1
            else:
                freq[ch]=1
            mf=max(mf,freq[ch])
            while (j-i+1)-mf>k:
                freq[s[i]]-=1
                i+=1
            ans=max(ans,j-i+1)
        return ans
